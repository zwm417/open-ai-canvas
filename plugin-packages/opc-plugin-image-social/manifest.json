{
  "apiVersion": "yingce.plugin/v1",
  "id": "opc-plugin-image-social",
  "name": "自媒体营销与爆款社媒",
  "version": "1.1.0",
  "description": "提供小红书爆款封面、YouTube爆款缩略图、真实买家秀随拍等新媒体高转化视觉工作流技能。",
  "author": "opc-Copilot",
  "surfaces": ["fullscreen", "settings"],
  "permissions": [
    "generation.run",
    "media.read",
    "ai.text"
  ],
  "trusted": true,
  "runtime": { "backend": "trusted-backend", "web": "declarative" },
  "contributes": {
    "workbenchCategories": [
      {
        "id": "social",
        "name": "社媒",
        "icon": "share-2",
        "order": 6
      }
    ],
    "workbenchSkills": [
      {
        "id": "xiaohongshu-cover",
        "categoryId": "social",
        "secondaryCategoryIds": ["recommend", "social"],
        "name": "小红书爆款封面",
        "subtitle": "高饱和高明度抓眼球封面",
        "description": "具备强视觉吸引力的生活方式封面，自然预留上部或侧边标题大字摆放区域，支持多图组合与图文排版强化。",
        "isRecommended": true,
        "defaultAspectRatio": "3:4",
        "defaultCount": 1,
        "keywords": ["小红书", "xhs", "封面", "种草", "排版", "爆款", "图文"]
      },
      {
        "id": "youtube-thumbnail",
        "categoryId": "social",
        "secondaryCategoryIds": ["recommend", "social"],
        "name": "YouTube爆款缩略图",
        "subtitle": "高点击率与戏剧性视线焦点",
        "description": "16:9 极速吸睛缩略图，通过特写夸张神态表情、高反差环境与好奇心视觉缺口引爆点击。",
        "isRecommended": true,
        "defaultAspectRatio": "16:9",
        "defaultCount": 1,
        "keywords": ["youtube", "ytb", "油管", "缩略图", "视频封面", "点击率"]
      },
      {
        "id": "buyer-show-ugc",
        "categoryId": "social",
        "secondaryCategoryIds": ["social"],
        "name": "真实买家秀随拍",
        "subtitle": "去影棚化自然光随手拍",
        "description": "模拟真实手机自然抓拍视角、生活化桌面与微弱日常曝光，极具真实可信度。",
        "defaultAspectRatio": "3:4",
        "defaultCount": 1,
        "keywords": ["买家秀", "ugc", "真实随拍", "生活随手拍"]
      }
    ]
  }
}
